{
  "name": "@uniswap/v2-core",
  "description": "🎛 Core contracts for the UniswapV2 protocol",
  "version": "1.0.1",
  "homepage": "https://uniswap.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/Uniswap/uniswap-v2-core"
  },
  "keywords": [
    "uniswap",
    "ethereum",
    "v2",
    "core",
    "uniswap-v2"
  ],
  "files": [
    "contracts",
    "build"
  ],
  "engines": {
    "node": ">=10"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "1",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.9",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0",
    "@nomicfoundation/ignition-core": "^0.15.9",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.2.6",
    "@types/mocha": "^5.2.7",
    "chai": "^4.2.0",
    "commitizen": "^4.3.1",
    "dotenv": "^16.4.7",
    "ethereum-waffle": "^2.4.1",
    "ethereumjs-util": "^6.2.0",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.18",
    "hardhat-deploy": "^0.14.0",
    "hardhat-gas-reporter": "^2.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "mocha": "^6.2.2",
    "prettier": "^1.19.1",
    "rimraf": "^3.0.0",
    "solc": "0.5.16",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^8.5.4",
    "typechain": "^8.3.0",
    "typescript": "^3.7.3"
  },
  "dependencies": {},
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ]
  },
  "scripts": {
    "lint": "prettier ./scripts/*.js --write",
    "lint:fix": "prettier ./test/*.js --write",
    "clean": "rimraf ./build/",
    "precompile": "yarn clean",
    "compile": "waffle .waffle.json",
    "pretest": "yarn compile",
    "test": "mocha",
    "prepublishOnly": "yarn test",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "license": "GPL-3.0-or-later"
}
